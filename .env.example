# MongoDB (create a dedicated database/user for the client)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=erd_algwal

# Telegram admin bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://your-domain.example/api/telegram/webhook

# Public site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: used by AI phone-case color-mask preparation features
MODEL_API_KEY=
